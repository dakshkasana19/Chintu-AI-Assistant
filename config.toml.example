[assistant]
# Local-only defaults for Chintu.
# Copy this file to config.toml and adjust values as needed.
wake_words = ["chintu", "hey chintu", "ok chintu", "chinto", "chintoo"]
exit_phrases = ["exit", "sleep", "go to sleep", "goodbye", "stop listening"]
sample_rate_hz = 16000
frame_size_ms = 30
vad_preroll_ms = 300
vad_start_speech_ms = 90
vad_end_silence_ms = 700
max_utterance_seconds = 15
silero_threshold = 0.5
webrtc_aggressiveness = 2
audio_recovery_seconds = 1.0
wake_confirm_window_seconds = 2.0
wake_sensitivity = 0.5
wake_cooldown_seconds = 2.0
asr_model_size = "base"
asr_no_speech_threshold = 0.6
asr_log_prob_threshold = -1.0
asr_compression_ratio_threshold = 2.4
logging_level = "INFO"
log_dir = "logs"
model_dir = "models"

# Optional Start Menu app names, paths, or Windows App IDs keyed by spoken alias.
[assistant.app_aliases]
# editor = "Visual Studio Code"
# browser = "Microsoft Edge"
